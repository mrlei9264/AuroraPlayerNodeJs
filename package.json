{
  "name": "aurora-player",
  "productName": "Aurora Player",
  "version": "1.0.0",
  "description": "Aurora Player - a modern cross-platform media player with library management, remote media sources and aurora visuals",
  "main": "dist-main/index.js",
  "author": "Aurora Project",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "postinstall": "patch-package && npm run mpv:rebuild",
    "mpv:rebuild": "node scripts/patch-node-gyp-vs2026.mjs && node scripts/rebuild-mpv.mjs",
    "dist": "npm run build && electron-builder --win --x64 --config electron-builder.json"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "basic-ftp": "^6.2.0",
    "electron-mpv-video": "^0.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "proxy-agent": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smb2": "^0.2.11",
    "sql.js": "^1.14.1",
    "ssh2-sftp-client": "^12.1.1",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "40.10.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "patch-package": "^8.0.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "electron@40.10.5": true,
    "electron-mpv-video@0.1.1": true,
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true
  }
}
