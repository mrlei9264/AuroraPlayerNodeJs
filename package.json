{
  "name": "aurora-player",
  "productName": "Aurora Player",
  "version": "1.0.1",
  "description": "Aurora Player - a modern cross-platform media player with library management, remote media sources and aurora visuals",
  "main": "dist-main/index.js",
  "author": "Aurora Project",
  "license": "MIT",
  "private": true,
  "scripts": {
    "tool": "node scripts/tool.mjs",
    "dev": "node scripts/tool.mjs dev",
    "build": "node scripts/tool.mjs build",
    "build:full": "node scripts/tool.mjs build --full",
    "build:main": "node scripts/tool.mjs build --scope main",
    "build:renderer": "node scripts/tool.mjs build --scope renderer",
    "start": "node scripts/tool.mjs start",
    "typecheck": "node scripts/tool.mjs typecheck",
    "doctor": "node scripts/tool.mjs doctor",
    "clean": "node scripts/tool.mjs clean",
    "version:check": "node scripts/tool.mjs version check",
    "version:set": "node scripts/tool.mjs version set",
    "postinstall": "node scripts/tool.mjs postinstall",
    "mpv:rebuild": "node scripts/tool.mjs native rebuild",
    "patch:apply": "node scripts/tool.mjs patch apply",
    "patch:create": "node scripts/tool.mjs patch create",
    "dist": "node scripts/tool.mjs dist",
    "dist:portable": "node scripts/tool.mjs dist --target portable",
    "dist:dir": "node scripts/tool.mjs dist --target dir",
    "delta:create": "node scripts/tool.mjs delta create",
    "delta:apply": "node scripts/tool.mjs delta apply",
    "release": "node scripts/tool.mjs release prepare",
    "release:publish": "node scripts/tool.mjs release publish"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "basic-ftp": "^6.2.0",
    "electron-mpv-video": "^0.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "motion": "^13.1.1",
    "proxy-agent": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smb2": "^0.2.11",
    "sql.js": "^1.14.1",
    "ssh2-sftp-client": "^12.1.1",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "40.10.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "patch-package": "^8.0.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "electron@40.10.5": true,
    "electron-mpv-video@0.1.1": true,
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true
  }
}
